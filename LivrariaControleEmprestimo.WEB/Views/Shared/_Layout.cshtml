<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Livraria</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/livraria.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#conteudo">Ir para o conteúdo</a>
    <header class="topo">
        <nav class="container navegacao" aria-label="Menu principal">
            <a class="marca" asp-controller="Home" asp-action="Index">Livraria<span> / </span>Acervo</a>
            <div class="links">
                @foreach (var item in new[] { ("Home", "Painel"), ("Livro", "Catálogo"), ("Cliente", "Leitores"), ("Emprestimo", "Empréstimos") })
                {
                    var atual = (string?)ViewContext.RouteData.Values["controller"] == item.Item1;
                    <a asp-controller="@item.Item1" asp-action="Index" aria-current="@(atual ? "page" : null)">@item.Item2</a>
                }
            </div>
        </nav>
    </header>
    <main id="conteudo" class="container conteudo">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }
        @if (TempData["Aviso"] is string aviso)
        {
            <div class="alert alert-warning" role="alert">@aviso</div>
        }
        @RenderBody()
    </main>
    <footer class="rodape"><div class="container">Livraria · Controle de empréstimos</div></footer>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
